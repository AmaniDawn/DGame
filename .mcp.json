{
  "mcpServers": {
    "unity-cli-mcp": {
      "command": "GameUnity/Tools/unity.exe",
      "args": ["mcp", "--project-path", "GameUnity", "--no-log-proxy"],
      "env": {
        "UNITY_NO_UPDATE_CHECK": "1"
      }
    },
    "rider": {
      "type": "sse",
      "url": "http://localhost:64342/sse"
    },
    "luban": {
      "command": "python",
      "args": [".agents/skills/luban-dev/scripts/luban_ai.py", "mcp"]
    }
  }
}
