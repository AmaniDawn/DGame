      "expected_literals": [
        "GameModule.AudioModule",
        "GameModule.UIModule",
        "GameModule.GameTimerModule"
      ],
      "forbidden_literals": [
        "ModuleSystem.GetModule"
      ]
    },
    {
      "id": 3,
      "name": "hotfix-entrance",
