    {
      "id": 5,
      "name": "resource-load-release",
      "description": "验证资源加载和释放遵循 GameModule.ResourceModule 生命周期。",
      "prompt": "在 DGame 热更 UI 中异步加载一个 TextAsset，窗口关闭时释放资源，并在加载前检查资源是否存在。",
      "expected_patterns": [
        "ContainsAsset|CheckLocationValid"
      ],
      "forbidden_patterns": [
        "GameModule\\.Resource\\b"
      ],
      "expected_literals": [
        "GameModule.ResourceModule",
        "LoadAssetAsync<",
        "UnloadAsset",
        "GetCancellationTokenOnDestroy"
      ],
      "forbidden_literals": [
        "HasAsset",
        "Resources.Load",
        "StartCoroutine"
      ]
    },
    {
      "id": 6,
      "name": "interface-event-troubleshooting",
      "description": "验证接口事件无响应排障会检查 DGame 初始化、特性和生成代码。",
      "prompt": "DGame 中 GameEvent.Get<ILocalization>().OnLanguageChanged 调了但 UI 没响应，给出排查步骤。",
      "expected_patterns": [
        "I.*_Event"
      ],
      "forbidden_patterns": [],
      "expected_literals": [
        "GameEventLauncher.Init",
        "[EventInterface(EEventGroup",
        "AddUIEvent",
        "参数签名"
      ],
      "forbidden_literals": [
        "GameEventHelper.Init",
        "RegisterListener",
        "GameEventMgr"
      ]
    },
    {
      "id": 7,
      "name": "event-memory-leak",
      "description": "验证 UI 与非 UI 事件监听清理边界。",
      "prompt": "一个 DGame 窗口关闭后还收到金币变化事件，如何修复？同时说明非 UI 类怎么处理。",
      "expected_patterns": [],
