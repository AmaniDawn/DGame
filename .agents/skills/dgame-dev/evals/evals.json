      ],
      "forbidden_literals": [
        "Entrance(List<Assembly>"
      ]
    },
    {
      "id": 4,
      "name": "luban-boundary",
      "description": "验证配置表结构修改会转向 luban-dev，业务消费才使用 dgame-dev。",
