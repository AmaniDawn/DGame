        "DestroyGameTimer",
        "OnDestroy"
      ],
      "forbidden_literals": [
        "GameModule.Timer",
        "StartCoroutine",
        "InvokeRepeating"
      ]
    },
    {
      "id": 9,
      "name": "scene-switch",
      "description": "验证场景切换使用 SceneModule 且能处理卸载。",
      "prompt": "在 DGame 中从大厅切到战斗场景，并卸载旧子场景，应该使用哪些 API？",
