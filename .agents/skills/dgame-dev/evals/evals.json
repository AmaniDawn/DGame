      "expected_literals": [
        "RegisterEvent",
        "AddUIEvent",
        "GameEvent.RemoveEventListener",
        "非 UI"
      ],
      "forbidden_literals": [
        "GameEvent.UnRegisterAll",
        "GameEvent.Shutdown",
        "GameEventMgr.Clear"
      ]
    },
    {
