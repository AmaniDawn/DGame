    {
      "id": 14,
      "name": "resource-callback-overloads",
      "description": "验证资源文档能覆盖 DGame 回调式 LoadAssetAsync 重载，同时仍提示新增业务优先 UniTask。",
      "prompt": "DGame 里有一段旧代码需要用回调式异步加载材质，并需要进度和失败回调。请给出正确 API 和注意事项。",
      "expected_patterns": [
        "LoadAssetAsync<.*Action<"
      ],
      "forbidden_patterns": [
        "GameModule\\.Resource\\b"
      ],
      "expected_literals": [
        "LoadAssetCallbacks",
        "LoadAssetSuccessCallback",
        "LoadAssetFailureCallback",
        "LoadAssetUpdateCallback",
        "UniTask"
      ],
      "forbidden_literals": [
        "HasAsset",
        "Resources.Load",
        "StartCoroutine"
      ]
    },
    {
      "id": 15,
      "name": "aot-generic-supplement",
      "description": "验证 HybridCLR AOT 泛型异常会指向 DGame 实际 AOT 元数据和显式泛型引用流程。",
      "prompt": "DGame 热更代码真机报 ExecutionEngineException，堆栈里有 List<MyData> 和 UniTask<MyData>，Editor 正常，怎么排查和修复？",
      "expected_patterns": [
        "AOTGenericReferences|显式泛型|HybridCLROptimizer"
      ],
      "forbidden_patterns": [
        "只.*Editor"
      ],
      "expected_literals": [
        "AOT",
        "ExecutionEngineException",
        "UpdateSettings.AOTMetaAssemblies",
        "HybridCLR",
        "BuildPlayer"
      ],
      "forbidden_literals": [
        "dynamic",
        "Emit",
        "GameEventHelper"
      ]
    },
    {
      "id": 16,
      "name": "dlc-multi-package-load",
      "description": "验证 DLC 多包资源检查、下载和加载都传递相同 packageName，并使用 DGame ResourceModule API。",
      "prompt": "DGame 有 DLC_Chapter2 资源包，我要检查 BossPrefab 是否存在，不在本地则下载 DLC 包，然后加载 BossPrefab。",
      "expected_patterns": [
        "ContainsAsset|CheckLocationValid"
      ],
      "forbidden_patterns": [
        "GameModule\\.Resource\\b"
      ],
      "expected_literals": [
        "packageName",
        "DLC_Chapter2",
        "GameModule.ResourceModule",
        "CreateResourceDownloader",
        "LoadGameObjectAsync"
      ],
      "forbidden_literals": [
        "HasAsset",
        "LoadGameObjectAsync(\"BossPrefab\")",
        "Assets/BundleAssets"
      ]
    },
    {
      "id": 17,
      "name": "ios-il2cpp-stripping",
      "description": "验证 iOS 真机裁剪问题会指向 DGame link.xml、AOT 显式引用和 AOTMetaAssemblies。",
      "prompt": "DGame iOS 真机运行时反射创建类型失败，Editor 和 Android 都正常，怀疑 IL2CPP 裁剪。怎么排查？",
      "expected_patterns": [
        "iOS|IOS"
      ],
      "forbidden_patterns": [
        "只.*link\\.xml",
        "GameModule\\.Resource\\b"
      ],
      "expected_literals": [
        "IL2CPP",
        "link.xml",
        "HybridCLRGenerate",
        "DisStripCode",
        "UpdateSettings.AOTMetaAssemblies",
        "显式引用"
      ],
      "forbidden_literals": [
        "GameEventMgr"
      ]
    },
    {
      "id": 19,
      "name": "set-sprite-callback",
      "description": "验证 Image 设置图片使用 SetSprite 扩展，其回调是 Action<Image>，不是 Action<Sprite>。",
      "prompt": "我要给一个 Image 异步设置图集里的图标，加载完成后做一些处理，应该用哪个 API、回调签名是什么？",
      "expected_patterns": [],
      "forbidden_patterns": [],
      "expected_literals": [
        "SetSprite",
        "Action<Image>"
      ],
      "forbidden_literals": [
        "Action<Sprite>",
        "SetSpriteAsync"
      ]
