{
  "schemaVersion": 1,
  "skill_name": "dgame-dev",
  "evals": [
    {
      "id": 1,
      "name": "ui-window-lifecycle",
      "description": "验证 AI 能按 DGame 实际 UIWindow 生命周期生成代码。",
      "prompt": "在 DGame 中新增一个背包 UI，能显示物品列表并点击打开详情。",
      "expected_patterns": [
        "class .* : UIWindow"
      ],
      "forbidden_patterns": [],
      "expected_literals": [
        "ScriptGenerator",
        "RegisterEvent",
        "OnCreate",
        "OnRefresh",
        "GameModule.UIModule",
        "AddUIEvent"
      ],
      "forbidden_literals": [
        "WindowAttribute",
        "ShowUI",
        "Resources.Load",
        "StartCoroutine"
      ]
    },
    {
      "id": 2,
      "name": "module-access",
      "description": "验证业务代码优先通过 GameLogic.GameModule 访问模块。",
